# ---------------------------------------------------------------------------
# Discord credentials
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
# Bot tab -> Reset Token -> Copy. Never share this or commit it.
DISCORD_TOKEN=

# Application (client) ID from the General Information tab.
# Required for registering slash commands.
CLIENT_ID=

# Optional. Put your server ID here while developing so slash commands
# update instantly. Leave blank to register commands globally (up to 1 hour
# before they appear in every server).
GUILD_ID=

# ---------------------------------------------------------------------------
# Bot behaviour
# ---------------------------------------------------------------------------
# Prefix for classic text commands (default `:-`).
PREFIX=:-

# Optional. Comma-separated Discord user IDs allowed to run ownerOnly commands.
OWNER_IDS=

# error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Birthday feature
# ---------------------------------------------------------------------------
# Default time zone for birthday rollover. Guilds can override this with
# /birthday timezone. Use an IANA name, e.g. Europe/Berlin or America/New_York.
TIMEZONE=UTC

# Optional. Where bot.db (SQLite) lives. Defaults to ./data
# DATA_DIR=./data

# Optional. How often the scheduler checks for a date change, in milliseconds.
# Minimum 10000. Defaults to 60000 (once a minute).
# BIRTHDAY_CHECK_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# Reports (AI summaries)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint works. The key alone is enough: the defaults
# below point at Google's compatibility layer with gemini-3.5-flash-lite (the
# free-tier model). Without a key, /summary replies with these instructions
# instead of failing.
AI_API_KEY=

# Optional. Provider base URL, without /chat/completions.
# Google:      https://generativelanguage.googleapis.com/v1beta/openai
# OpenAI:      https://api.openai.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Groq:        https://api.groq.com/openai/v1
# DeepSeek:    https://api.deepseek.com
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional. Model id understood by that provider. Google retires old ids for
# new keys, and the free API tier is now Flash-Lite only; 3.6 Flash may need
# billing. Use gemini-3.5-flash-lite on a free key.
# AI_MODEL=gemini-3.5-flash-lite
# DeepSeek: AI_MODEL=deepseek-flash

# Optional. Reasoning models think before answering. That chain of thought is
# billed as output and can eat the whole max_tokens budget, so summaries should
# turn it off. Gemini ignores it even if this stays set; unset for the default.
# AI_THINKING=off

# Optional. Largest transcript sent in one request. Defaults to 60000.
# Longer windows are split into parts and merged afterwards.
# AI_MAX_INPUT_CHARS=60000

# ── Profile card backgrounds (optional) ─────────────────────────────────────
# Minimum level for /background custom. Defaults to 50.
# BACKGROUND_CUSTOM_LEVEL=50
# Set to 0 to stop auto-equipping the newest unlocked free design.
# BACKGROUND_AUTO_EQUIP=1

# ── Vex from E Bot 1 (optional) ───────────────────────────────────────────────
# E Bot 1 posts a vex-balances.json file in a private channel. When both are set,
# the profile card adds each member's E Bot 1 Vex, and the rank/level count it too.
# EBOT_VEX_CHANNEL_ID: that channel's id (this bot needs View Channel + Read Message History)
# EBOT_BOT_ID: E Bot 1's user id (only its message is trusted)
EBOT_VEX_CHANNEL_ID=
EBOT_BOT_ID=

# ── Nightmare points from Al-Kabus (optional) ────────────────────────────────
# Al-Kabus posts nightmare-balances.json; it is added to NIGHTMARE POINTS.
# NIGHTMARE_CHANNEL_ID defaults to EBOT_VEX_CHANNEL_ID when empty.
NIGHTMARE_CHANNEL_ID=
NIGHTMARE_BOT_ID=
