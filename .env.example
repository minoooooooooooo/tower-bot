# ---------------------------------------------------------------------------
# Discord credentials
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
# Bot tab -> Reset Token -> Copy. Never share this or commit it.
DISCORD_TOKEN=

# Application (client) ID from the General Information tab.
# Required for registering slash commands.
CLIENT_ID=

# Optional. Put your server ID here while developing so slash commands
# update instantly. Leave blank to register commands globally (up to 1 hour
# before they appear in every server).
GUILD_ID=

# ---------------------------------------------------------------------------
# Bot behaviour
# ---------------------------------------------------------------------------
# Prefix for classic text commands (default `:-`).
PREFIX=:-

# Optional. Comma-separated Discord user IDs allowed to run ownerOnly commands.
OWNER_IDS=

# error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Birthday feature
# ---------------------------------------------------------------------------
# Default time zone for birthday rollover. Guilds can override this with
# /birthday timezone. Use an IANA name, e.g. Europe/Berlin or America/New_York.
TIMEZONE=UTC

# Optional. Where bot.db (SQLite) lives. Defaults to ./data
# DATA_DIR=./data

# Optional. How often the scheduler checks for a date change, in milliseconds.
# Minimum 10000. Defaults to 60000 (once a minute).
# BIRTHDAY_CHECK_INTERVAL_MS=60000
