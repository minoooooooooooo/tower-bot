# ---------------------------------------------------------------------------
# Discord credentials
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
# Bot tab -> Reset Token -> Copy. Never share this or commit it.
DISCORD_TOKEN=

# Application (client) ID from the General Information tab.
# Required for registering slash commands.
CLIENT_ID=

# Optional. Put your server ID here while developing so slash commands
# update instantly. Leave blank to register commands globally (up to 1 hour
# before they appear in every server).
GUILD_ID=

# ---------------------------------------------------------------------------
# Bot behaviour
# ---------------------------------------------------------------------------
# Prefix for classic text commands (default `:-`).
PREFIX=:-

# Optional. Comma-separated Discord user IDs allowed to run ownerOnly commands.
OWNER_IDS=

# error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Birthday feature
# ---------------------------------------------------------------------------
# Default time zone for birthday rollover. Guilds can override this with
# /birthday timezone. Use an IANA name, e.g. Europe/Berlin or America/New_York.
TIMEZONE=UTC

# Optional. Where bot.db (SQLite) lives. Defaults to ./data
# DATA_DIR=./data

# Optional. How often the scheduler checks for a date change, in milliseconds.
# Minimum 10000. Defaults to 60000 (once a minute).
# BIRTHDAY_CHECK_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# Reports (AI summaries)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint works. The key alone is enough: the defaults
# below point at Google's compatibility layer with gemini-3.5-flash-lite (the
# free-tier model). Without a key, /summary replies with these instructions
# instead of failing.
AI_API_KEY=

# Optional. Provider base URL, without /chat/completions.
# Google:      https://generativelanguage.googleapis.com/v1beta/openai
# OpenAI:      https://api.openai.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Groq:        https://api.groq.com/openai/v1
# DeepSeek:    https://api.deepseek.com
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional. Model id understood by that provider. Google retires old ids for
# new keys, and the free API tier is now Flash-Lite only; 3.6 Flash may need
# billing. Use gemini-3.5-flash-lite on a free key.
# AI_MODEL=gemini-3.5-flash-lite
# DeepSeek: AI_MODEL=deepseek-flash

# Optional. Reasoning models think before answering. That chain of thought is
# billed as output and can eat the whole max_tokens budget, so summaries should
# turn it off. Gemini ignores it even if this stays set; unset for the default.
# AI_THINKING=off

# Optional. Largest transcript sent in one request. Defaults to 60000.
# Longer windows are split into parts and merged afterwards.
# AI_MAX_INPUT_CHARS=60000

# ── Profile card backgrounds (optional) ─────────────────────────────────────
# Minimum level for /background custom. Defaults to 50.
# BACKGROUND_CUSTOM_LEVEL=50
# Set to 0 to stop auto-equipping the newest unlocked free design.
# BACKGROUND_AUTO_EQUIP=1

# ── Vex from E Bot 1 (optional) ───────────────────────────────────────────────
# E Bot 1 posts a vex-balances.json file in a private channel. When both are set,
# the profile card adds each member's E Bot 1 Vex, and the rank/level count it too.
# EBOT_VEX_CHANNEL_ID: that channel's id (this bot needs View Channel + Read Message History)
# EBOT_BOT_ID: E Bot 1's user id (only its message is trusted)
EBOT_VEX_CHANNEL_ID=
EBOT_BOT_ID=

# ── Nightmare points from Al-Kabus (optional) ────────────────────────────────
# Al-Kabus posts nightmare-balances.json; it is added to NIGHTMARE POINTS.
# NIGHTMARE_CHANNEL_ID defaults to EBOT_VEX_CHANNEL_ID when empty.
NIGHTMARE_CHANNEL_ID=
NIGHTMARE_BOT_ID=

# ---------------------------------------------------------------------------
# Tower Control Center (optional website control panel)
# ---------------------------------------------------------------------------
# Leave both empty to keep the integration completely off. The bot behaves
# exactly as before; nothing connects anywhere.
#
# Only enable this if you trust the site owner: the agent lets that backend
# read the bot folder, write files, stage deploys, restore the database and
# restart the bot.
#
# TCC_URL: wss:// address given by the site owner.
# TCC_AGENT_SECRET: per-bot secret given by the site owner. If omitted, the
#   agent looks for .tcc/agent.json (created by the panel's setup flow).
TCC_URL=
TCC_AGENT_SECRET=

# Optional. Exit code used when the website presses Restart. Defaults to 1.
# TCC_RESTART_EXIT_CODE=1

# ---------------------------------------------------------------------------
# Store Activity (optional Discord Activity storefront)
# ---------------------------------------------------------------------------
# A Discord Activity is an embedded web app opened from the "Open store" button
# on /store. It needs an HTTPS URL that Discord can iframe, an OAuth2 client
# secret, and an inbound port. Leave ACTIVITY_ENABLED empty and nothing starts:
# the bot (and /store with its dropdown menus) works exactly as it does now.
#
# Step-by-step setup, including the Developer Portal fields and a reverse proxy
# example, is in docs/activity-store.md.
#
# ACTIVITY_ENABLED=1
#
# OAuth2 client secret from the Developer Portal (OAuth2 tab). The bot swaps the
# one-time activity code for a token server-side, so this must never be exposed
# to the browser. CLIENT_ID above is also required.
DISCORD_CLIENT_SECRET=

# Optional. Port the activity HTTP server listens on. Defaults to 3000. It must
# be reachable from the public HTTPS URL below (usually via a reverse proxy).
# ACTIVITY_PORT=3000

# Optional. Bind address. Defaults to 0.0.0.0 so Docker/proxies can reach it;
# use 127.0.0.1 when a reverse proxy runs on the same host.
# ACTIVITY_HOST=0.0.0.0

# The public https:// URL Discord loads the activity from. Used for logs only.
# ACTIVITY_PUBLIC_URL=https://store.example.com

# Free alternative to a domain, a VPS and open ports: the bot downloads
# Cloudflare's tunnel client (about 35 MB, once, into data/) and opens a public
# HTTPS address from the same machine it already runs on. Nothing is installed
# on your PC and no account or card is needed.
#
# The address looks like https://calm-river-1234.trycloudflare.com. It stays
# the same until the bot restarts; after a restart it changes, so paste the new
# one into the Developer Portal URL mapping (the bot logs it and writes it to
# data/tunnel-url.txt). Give the new address a minute or two to resolve before
# saving it in the portal.
# TUNNEL_ENABLED=1

# Optional: a channel that receives the new address on every start, so the
# portal mapping can be updated from Discord without opening the panel console.
# The bot needs View Channel and Send Messages there; a wrong id only logs a
# warning. Leave empty to keep the address in the console only.
# ACTIVITY_URL_CHANNEL_ID=123456789012345678

