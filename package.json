{
  "name": "discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot with slash and prefix command support",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/boot.js",
    "dev": "node --watch src/boot.js",
    "deploy": "node src/deploy-commands.js",
    "check": "node --check src/index.js",
    "build:activity": "esbuild node_modules/@discord/embedded-app-sdk/output/index.mjs --bundle --format=esm --minify --target=es2020 --outfile=src/activity/public/vendor/discord-sdk.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "omggif": "^1.0.10"
  },
  "devDependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "esbuild": "^0.25.0"
  }
}
