# Normalise line endings so the Linux host gets LF and Windows keeps CRLF
# where it matters. Without this, git on Windows can commit CRLF into files
# that are then executed by Node on the server.
* text=auto eol=lf

# Batch files must stay CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch these.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.db binary
